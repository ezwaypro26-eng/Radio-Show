# Server-only credentials: do NOT commit real API keys.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: use ElevenLabs for all direct-episode speech.
# Default is the original Gemini voice pipeline.
RADIO_TTS_PROVIDER=gemini

# George is an ElevenLabs sample voice, not a clone of OG BEATZ.
# Replace with a voice ID you are entitled to use.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
